# Google Cloud binding of o2c-agent-service on the free tier (hub design note GCP-01). PLACEHOLDERS
# until the account exists: filled at cutover. Nothing secret belongs here (the Gemini key lives in
# Secret Manager), which is why this is .vars and not .env (the repository ignores *.env).
# o2c-agent-service/infra reads these as TF_VAR_*; empty values keep the full (non-free) setup.
GCP_PROJECT_ID=finance-ai-landscape-PLACEHOLDER
GCP_REGION=us-central1
# the landscape's one Artifact Registry repository (infra/foundation of enterprise-finance-genai-assistant)
O2C_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/o2c-agent-service:latest
IMAGE_REPOSITORY=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape
# the project's one free Firestore database, shared; O2C keeps its documents in collection "o2c"
FIRESTORE_DATABASE=(default)
# one scheduler job for events and recovery (the landscape's three free jobs: O2C, reconciliation, settlement)
COMBINED_SCHEDULE=*/2 * * * *
MAX_INSTANCE_COUNT=1
# the two services O2C calls (their Cloud Run URLs, known after their first apply)
SETTLEMENT_API_URL=https://settlement-service-PLACEHOLDER.us-central1.run.app
RECONCILIATION_API_URL=https://reconciliation-service-PLACEHOLDER.us-central1.run.app
# identity: Cloud Run IAM verifies callers' Google ID tokens; calls out carry this service's own
IDENTITY_SOURCE=gcp_cloud_run
WORKLOAD_IDENTITY=gcp_id_token
# who may call O2C, and what each may do (tenants as "tenant:<id>"); JSON, e.g. the assistant's account
# and the people who place and approve orders (their Google accounts)
INVOKER_MEMBERS=serviceAccount:genai-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com,user:sales-PLACEHOLDER@example.com,user:approver-PLACEHOLDER@example.com
IDENTITY_SUBJECT_ROLES={"genai-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com":["tenant:acme","finance"],"sales-PLACEHOLDER@example.com":["tenant:acme","sales"],"approver-PLACEHOLDER@example.com":["tenant:acme","finance-approver"]}
# simulated (no key) or gemini_api (free tier; the image built with POETRY_EXTRAS=gemini, the key in Secret Manager)
E2A_PROVIDER_PROFILE=simulated
GEMINI_API_KEY_SECRET=
LLM_MODEL_ID=
