@startuml
!include ../common/style.puml
title Order and approval states
state "Order" as O {
  [*] --> REFUSED : credit limit / insufficient stock
  [*] --> PENDING_PAYMENT : stock reserved, order created
  PENDING_PAYMENT --> PAID : settlement COMMITTED
  PENDING_PAYMENT --> CANCELLED : settlement NOT_COMMITTED\n(stock released)
  PENDING_PAYMENT --> PAYMENT_UNKNOWN : no definitive answer
  PAYMENT_UNKNOWN --> PAID : recovery, same key
  PAYMENT_UNKNOWN --> CANCELLED : recovery, declined
}
state "Approval (checkpoint)" as AP {
  [*] --> PENDING : amount > threshold
  PENDING --> APPROVED : finance-approver,\nnot the requester
  PENDING --> REJECTED : finance-approver
  APPROVED --> [*] : workflow resumes at act
}
@enduml
