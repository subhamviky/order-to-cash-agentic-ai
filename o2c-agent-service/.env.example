# Application
APP_NAME=o2c-agent-service
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Cloud Platform (gcp)
GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_MODEL_ID=gemini-2.5-pro

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=o2c-agent-service

# E2A Framework NFRs
MIN_CONFIDENCE=0.85
MAX_LATENCY=2.0
MAX_TOKENS=5000
TOOL_TIMEOUT=5.0
TOOL_RETRIES=3
